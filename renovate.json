{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)docker-compose\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)umbrel-app\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?)(?: currentValue=(?<currentValue>[^\\s]+?))?\\nversion:\\s*\"?(?<currentDigest>sha256:[a-f0-9]+|[^\"\\s]+)\"?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Bündelt Änderungen an umbrel-app.yml und docker-compose.yml derselben App in einen gemeinsamen Pull Request",
      "matchFileNames": [
        "**/umbrel-app.yml",
        "**/docker-compose.yml"
      ],
      "groupName": "{{parentDir}} app updates"
    },
    {
      "description": "Aktiviert Digest-Pinning für gluetun",
      "matchPackageNames": [
        "qmcgaw/gluetun"
      ],
      "pinDigests": true
    }
  ]
}
